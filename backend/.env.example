# Copy to .env and adjust. Never commit real secrets.
ALGOTRADE_DATABASE_URL=postgresql+asyncpg://localhost:5432/algotrade
ALGOTRADE_REDIS_URL=redis://localhost:6379/0
ALGOTRADE_JWT_SECRET=generate-a-long-random-secret
# replay (recorded NSE session from Yahoo Finance) | o21 (021 market-data websocket)
ALGOTRADE_MARKET_DATA_MODE=replay
# paper (local paper-trading simulator, no real orders) | o21 (021 developer API)
ALGOTRADE_BROKER_MODE=paper
ALGOTRADE_REPLAY_SPEED=1
ALGOTRADE_STARTING_CAPITAL=1000000
