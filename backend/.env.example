# Copy to .env and adjust. Never commit real secrets.
ALGOTRADE_DATABASE_URL=postgresql+asyncpg://localhost:5432/algotrade
ALGOTRADE_REDIS_URL=redis://localhost:6379/0
ALGOTRADE_JWT_SECRET=generate-a-long-random-secret
# replay (recorded NSE session from Yahoo Finance) | angelone (Angel One live prices, replay when closed) | o21 (021 market-data websocket)
ALGOTRADE_MARKET_DATA_MODE=replay
# paper (local paper-trading simulator, no real orders) | o21 (021 developer API)
ALGOTRADE_BROKER_MODE=paper
ALGOTRADE_REPLAY_SPEED=1
ALGOTRADE_STARTING_CAPITAL=1000000

# Angel One SmartAPI (market_data_mode=angelone; prices only, orders stay on the paper simulator)
# API key from smartapi.angelone.in > My Apps; TOTP secret = the base32 text shown when enabling TOTP (not the 6-digit code)
ALGOTRADE_ANGEL_API_KEY=
ALGOTRADE_ANGEL_CLIENT_CODE=
ALGOTRADE_ANGEL_PIN=
ALGOTRADE_ANGEL_TOTP_SECRET=
