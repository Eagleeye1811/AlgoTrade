# Copy to .env and adjust. Never commit real secrets.
ALGOTRADE_DATABASE_URL=postgresql+asyncpg://localhost:5432/algotrade
ALGOTRADE_REDIS_URL=redis://localhost:6379/0
ALGOTRADE_JWT_SECRET=generate-a-long-random-secret
# auto | live | replay
ALGOTRADE_MARKET_DATA_MODE=auto
ALGOTRADE_REPLAY_SPEED=1
ALGOTRADE_STARTING_CAPITAL=1000000
