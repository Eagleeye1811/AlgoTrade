# Copy to backend/.env (local run) or ./.env (docker compose) and fill in. Never commit the real file.

# --- required -------------------------------------------------------------
ALGOTRADE_JWT_SECRET=change-me-to-a-long-random-string
# 021 developer sandbox: your UCC and password. Do not log in to this account anywhere else while the
# backend runs - every 021 login revokes the previous token.
ALGOTRADE_O21_USERNAME=
ALGOTRADE_O21_PASSWORD=

# --- infrastructure (defaults shown) --------------------------------------
ALGOTRADE_DATABASE_URL=postgresql+asyncpg://localhost:5432/algotrade
ALGOTRADE_REDIS_URL=redis://localhost:6379/0

# --- optional -------------------------------------------------------------
# Telegram copilot: token from @BotFather (<bot id>:<secret>). Empty = disabled.
ALGOTRADE_TELEGRAM_BOT_TOKEN=
# true = apply the NSE session rules (09:15 entry, 15:10 cut-off, 15:15 square-off)
ALGOTRADE_ENFORCE_MARKET_HOURS=false
# after hours: replay the last recorded 021 session through the strategies
ALGOTRADE_AFTER_HOURS_REPLAY=true
